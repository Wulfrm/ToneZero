{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tonezero-research",
  "main": "index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://wulfrm.github.io",
    "TURNSTILE_HOSTNAME": "wulfrm.github.io"
  },
  "ratelimits": [{
    "name": "TONE_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": {"limit": 3, "period": 60}
  }]
}
